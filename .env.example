# Copy this to .env (do NOT commit your real keys)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend / Render environment variables
EMAIL_PROVIDER=gmail_api
GMAIL_USER=your-gmail-address

# Gmail API email provider. Recommended on Render free because SMTP ports are blocked.
GMAIL_CLIENT_ID=your-google-oauth-client-id
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# SMTP fallback only. Do not use this on Render free.
GMAIL_PASS=your-gmail-app-password

UNISMS_SECRET_KEY=your-unisms-secret-key
# Only set this after UniSMS approves the sender ID for your account.
# If SMS fails with sender-related errors, leave this blank.
UNISMS_SENDER_ID=optional-approved-sender-id
VITE_BACKEND_URL=https://backend-y5h4.onrender.com
